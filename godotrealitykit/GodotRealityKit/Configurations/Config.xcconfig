// Project-level build settings shared by every target in this project.
// Per-target overrides live in Framework.xcconfig and Tests.xcconfig.
//
// SDKROOT and GDRK_TESTING_ENABLED come from build.gen.xcconfig, which is
// regenerated by the scheme PreAction before each Xcode build. See
// scripts/build/generate-build-config.sh.

#include "build.gen.xcconfig"

GEN_CONFIG_PATH = $(PROJECT_DIR)/Configurations/build.gen.xcconfig
GEN_RESOURCE_FILE_LIST_PATH = $(PROJECT_DIR)/Configurations/resources.gen.xcfilelist

// Architectures, platforms, deployment targets
ARCHS = arm64
MACOSX_DEPLOYMENT_TARGET = 26.0
ONLY_ACTIVE_ARCH = NO
SUPPORTED_PLATFORMS = macosx xros xrsimulator
SUPPORTS_MACCATALYST = NO
XROS_DEPLOYMENT_TARGET = 26.0

// Versioning
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 1.0
VERSIONING_SYSTEM = apple-generic
VERSION_INFO_PREFIX =

// Code signing
CODE_SIGN_STYLE = Automatic

// Language settings
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ANALYZER_NONNULL = YES
CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION = YES_AGGRESSIVE
CLANG_CXX_LANGUAGE_STANDARD = gnu++20
CLANG_ENABLE_MODULES = NO
CLANG_ENABLE_OBJC_ARC = YES
CLANG_ENABLE_OBJC_ARC_EXCEPTIONS = NO
CLANG_ENABLE_OBJC_WEAK = YES
GCC_C_LANGUAGE_STANDARD = gnu17
GCC_NO_COMMON_BLOCKS = YES

// Warnings
CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING = YES
CLANG_WARN_BOOL_CONVERSION = YES
CLANG_WARN_COMMA = YES
CLANG_WARN_CONSTANT_CONVERSION = YES
CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS = YES
CLANG_WARN_DIRECT_OBJC_ISA_USAGE = YES_ERROR
CLANG_WARN_DOCUMENTATION_COMMENTS = YES
CLANG_WARN_EMPTY_BODY = YES
CLANG_WARN_ENUM_CONVERSION = YES
CLANG_WARN_INFINITE_RECURSION = YES
CLANG_WARN_INT_CONVERSION = YES
CLANG_WARN_NON_LITERAL_NULL_CONVERSION = YES
CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF = YES
CLANG_WARN_OBJC_LITERAL_CONVERSION = YES
CLANG_WARN_OBJC_ROOT_CLASS = YES_ERROR
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = YES
CLANG_WARN_RANGE_LOOP_ANALYSIS = YES
CLANG_WARN_STRICT_PROTOTYPES = YES
CLANG_WARN_SUSPICIOUS_MOVE = YES
CLANG_WARN_UNGUARDED_AVAILABILITY = YES_AGGRESSIVE
CLANG_WARN_UNREACHABLE_CODE = YES
CLANG_WARN__DUPLICATE_METHOD_MATCH = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
GCC_WARN_64_TO_32_BIT_CONVERSION = YES
GCC_WARN_ABOUT_RETURN_TYPE = YES_ERROR
GCC_WARN_UNDECLARED_SELECTOR = YES
GCC_WARN_UNINITIALIZED_AUTOS = YES_AGGRESSIVE
GCC_WARN_UNUSED_FUNCTION = YES
GCC_WARN_UNUSED_VARIABLE = YES

// Misc project settings
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
COPY_PHASE_STRIP = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_NSHumanReadableCopyright =
LIBRARY_SEARCH_PATHS = $(SRCROOT)/../deps/godot-cpp/bin
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
MTL_FAST_MATH = YES
MTL_LANGUAGE_REVISION = Metal24

// Swift defaults; targets override what they need
SWIFT_COMPILATION_MODE = wholemodule
SWIFT_INSTALL_MODULE = YES
SWIFT_INSTALL_OBJC_HEADER = NO
SWIFT_OBJC_INTEROP_MODE = objcxx
SWIFT_UPCOMING_FEATURE_NONISOLATED_NONSENDING_BY_DEFAULT = NO

// Default linker flags. SDK-conditional flags pick the matching godot-cpp library.
OTHER_LDFLAGS =
OTHER_LDFLAGS[sdk=macosx*] = -lgodot-cpp.macos.editor.universal
OTHER_LDFLAGS[sdk=xros*] = -lgodot-cpp.visionos.template.arm64
OTHER_LDFLAGS[sdk=xrsimulator*][config=Debug] = -lgodot-cpp.visionos.template_debug.arm64.simulator
OTHER_LDFLAGS[sdk=xrsimulator*][config=Release] = -lgodot-cpp.visionos.template_release.arm64.simulator

// Common preprocessor defines.
// Each $(GDRK_..._DEFINE) below is empty unless the matching qualifier
// fires; this avoids the duplicates you get from layering qualified
// GCC_PREPROCESSOR_DEFINITIONS lines (each [sdk=...]/[config=...] line
// is additive, not overriding).
//
// TESTING_ENABLED is sourced from build.gen.xcconfig (1 when running tests, 0 otherwise).
GDRK_DEBUG_DEFINE =
GDRK_DEBUG_DEFINE[config=Debug] = DEBUG=1

GDRK_MACOS_DEFINE =
GDRK_MACOS_DEFINE[sdk=macosx*] = MACOS_ENABLED=1

GCC_PREPROCESSOR_DEFINITIONS = $(inherited) TESTING_ENABLED=$(GDRK_TESTING_ENABLED) MATERIALS_CODE_HASH=$(GDRK_MATERIALS_CODE_HASH) $(GDRK_DEBUG_DEFINE) $(GDRK_MACOS_DEFINE)

// Debug vs Release split (applies to every build configuration named Debug/Release)
GCC_DYNAMIC_NO_PIC[config=Debug] = NO
GCC_OPTIMIZATION_LEVEL[config=Debug] = 0
ENABLE_TESTABILITY[config=Debug] = YES
DEBUG_INFORMATION_FORMAT[config=Debug] = dwarf
DEBUG_INFORMATION_FORMAT[config=Release] = dwarf-with-dsym
ENABLE_NS_ASSERTIONS[config=Release] = NO
MTL_ENABLE_DEBUG_INFO[config=Debug] = INCLUDE_SOURCE
MTL_ENABLE_DEBUG_INFO[config=Release] = NO
